generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                  String   @id @default(uuid())
  name                String
  domain              String?
  industry            String
  companySize         String   @map("company_size")
  country             String
  acquisitionChannel  String   @map("acquisition_channel")
  createdAt           DateTime @default(now()) @map("created_at")
  convertedAt         DateTime? @map("converted_at")
  churnedAt           DateTime? @map("churned_at")
  status              String

  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  productEvents ProductEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([churnedAt])
  @@map("customers")
}

model Plan {
  id                String   @id @default(uuid())
  name              String
  billingInterval   String   @map("billing_interval")
  basePrice         Decimal? @map("base_price") @db.Decimal(12, 2)
  seatPrice         Decimal? @map("seat_price") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String    @id @default(uuid())
  customerId        String    @map("customer_id")
  planId            String    @map("plan_id")
  status            String
  startedAt         DateTime  @map("started_at")
  endedAt           DateTime? @map("ended_at")
  billingInterval   String    @map("billing_interval")
  currentMrr        Decimal   @map("current_mrr") @db.Decimal(12, 2)
  seats             Int

  customer  Customer  @relation(fields: [customerId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])
  invoices  Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([startedAt, endedAt])
  @@map("subscriptions")
}

model Invoice {
  id              String    @id @default(uuid())
  customerId      String    @map("customer_id")
  subscriptionId  String?   @map("subscription_id")
  amount          Decimal   @db.Decimal(12, 2)
  currency        String
  status          String
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  paidAt          DateTime? @map("paid_at")
  failedAt        DateTime? @map("failed_at")

  customer      Customer  @relation(fields: [customerId], references: [id])
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  payments      Payment[]

  @@index([customerId, invoiceDate])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id              String    @id @default(uuid())
  invoiceId       String    @map("invoice_id")
  customerId      String    @map("customer_id")
  amount          Decimal   @db.Decimal(12, 2)
  status          String
  paymentMethod   String    @map("payment_method")
  processedAt     DateTime  @map("processed_at")

  customer  Customer  @relation(fields: [customerId], references: [id])
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model ProductEvent {
  id          BigInt    @id @default(autoincrement())
  customerId  String    @map("customer_id")
  userId      String?   @map("user_id")
  eventName   String    @map("event_name")
  properties  Json?
  timestamp   DateTime

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, timestamp])
  @@index([eventName, timestamp])
  @@map("product_events")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          String    @default("viewer")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model DatasetMetadata {
  id         String   @id @default("local")
  asOf       DateTime @map("as_of")
  currency   String   @default("USD")
  importedAt DateTime @default(now()) @map("imported_at")
  rowCount   Int      @map("row_count")
  sourceId   String   @default(uuid()) @map("source_id")
  sourceName String   @default("Local dataset") @map("source_name")
  historyStart DateTime? @map("history_start") @db.Date
  historyComplete Boolean @default(false) @map("history_complete")
  revision Int @default(0)
  analyticsRevision Int @default(-1) @map("analytics_revision")
  pipelineStatus String @default("pending") @map("pipeline_status")

  @@map("dataset_metadata")
}
